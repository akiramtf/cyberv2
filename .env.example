# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false

# Model Configuration
MODEL_PATH=models/trained
MODEL_VERSION=v1
ENABLE_ZERO_DAY_DETECTION=true
ANOMALY_THRESHOLD=0.3

# Feature Extraction
ENABLE_DNS_LOOKUP=true
ENABLE_WHOIS_LOOKUP=false
ENABLE_CONTENT_FETCH=false
REQUEST_TIMEOUT=5

# Security
API_KEY_ENABLED=false
API_KEY=your-secret-api-key-here
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CALLS=100
RATE_LIMIT_PERIOD=60

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/phishing_detector.log

# Training
TRAIN_DATA_PATH=data/processed/train.csv
TEST_DATA_PATH=data/processed/test.csv
MODEL_SAVE_PATH=models/trained
RANDOM_SEED=42
